# bin/polar-dev: your dev container, as a pod in whatever cluster kubectl points at, local or not. Your machine needs kubectl,
# ssh and git; everything else (Nix, the tools, the builds, up.nu) runs in the pod. You reach it over SSH with your agent
# forwarded, so git there uses your own key and none is kept in the cluster.
#
#   bin/polar-dev up        make or update the pod, clone the sources into it if they are not there, and log in
#   bin/polar-dev attach    log in again
#   bin/polar-dev cert [u]  copy your Polar certificate out and import it into Librewolf here (infra/user-cert-install.sh)
#   bin/polar-dev forward   the port-forwards a browser here needs: Neo4j (7473, 7687) and ACE (8050)
#   bin/polar-dev sync      copy ~/.config/polar-deploy (the deployment PKI and its signed history) and polar-admin back here
#   bin/polar-dev down      sync, then stop the pod (its volumes stay); --purge removes the namespace and the volumes too
#
# Settings (environment): POLAR_DEV_IMAGE, POLAR_DEV_ARCH (amd64 or arm64; default: the cluster's nodes'),
# POLAR_DEV_STORAGE_CLASS (default: the cluster's), POLAR_DEV_SSH_KEY (the public key to log in with; default: the first
# your agent holds), POLAR_DEV_SOPS_KEY (the private key sops decrypts with; default:
# SOPS_AGE_SSH_PRIVATE_KEY_FILE, else ~/.ssh/id_ed25519), POLAR_DEV_REPO and POLAR_DEV_BRANCH (what is cloned),
# POLAR_DEV_PORT (local end of the SSH forward, 2222).
set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
U=$(id -un | tr '[:upper:]_.' '[:lower:]--')
NS=polar-dev-$U
DEPLOY=polar-dev-$U
REPO=${POLAR_DEV_REPO:-git@52.235.181.217:SEI/ACE.git}
BRANCH=${POLAR_DEV_BRANCH:-feat/ace-integration}
PORT=${POLAR_DEV_PORT:-2222}
SOPS_KEY=${POLAR_DEV_SOPS_KEY:-${SOPS_AGE_SSH_PRIVATE_KEY_FILE:-$HOME/.ssh/id_ed25519}}
REMOTE_HOME=/home/$(id -un)
# The pod's host keys are kept on its state volume, so they stay the same while the namespace does; a new namespace (a new
# cluster, or after down --purge) is a new pod with new keys. So the keys ssh trusts are kept per namespace, by its uid.
ssh_opts() {
    local uid; uid=$(kubectl get namespace "$NS" -o jsonpath='{.metadata.uid}' 2>/dev/null) || true
    SSH_OPTS=(-A -p "$PORT" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$HOME/.ssh/polar-dev_known_hosts.${uid:0:8}")
}

die() { echo "polar-dev: $*" >&2; exit 1; }
k() { kubectl -n "$NS" "$@"; }
say() { echo "polar-dev: $*"; }

# The architecture the pod runs on: its nodes', not this machine's (a Mac against an amd64 cluster, a laptop against an
# arm64 one). A cluster whose nodes are of both is asked which, through POLAR_DEV_ARCH.
cluster_arch() {
    if [ -n "${POLAR_DEV_ARCH:-}" ]; then echo "$POLAR_DEV_ARCH"; return; fi
    local arches
    arches=$(kubectl get nodes -o jsonpath='{range .items[*]}{.status.nodeInfo.architecture}{"\n"}{end}' 2>/dev/null | grep . | sort -u) \
        || die "cannot read the cluster's nodes for their architecture (set POLAR_DEV_ARCH to amd64 or arm64)"
    [ "$(printf '%s\n' "$arches" | grep -c .)" -eq 1 ] \
        || die "the cluster's nodes are $(printf '%s\n' "$arches" | paste -s -d, -): set POLAR_DEV_ARCH to the one the pod should run on"
    echo "$arches"
}

# The newest of the dev pods (one being replaced may still be there).
pod() { k get pod -l app=polar-dev --sort-by=.metadata.creationTimestamp -o jsonpath='{.items[-1:].metadata.name}' 2>/dev/null; }

# Waits for the rollout, saying what the pod is doing as it happens: its status, each event (scheduled, pulling the image,
# pulled, started), and while the init container copies the image's Nix store to its volume, how much is copied.
wait_ready() {
    local p="" seen_status="" seen_events="" last_copy=0
    for _ in $(seq 1 720); do
        if k rollout status "deploy/$DEPLOY" --timeout=1s >/dev/null 2>&1; then say "the pod is ready"; return; fi
        p=$(pod)
        if [ -n "$p" ]; then
            local status; status=$(k get pod "$p" --no-headers 2>/dev/null | awk '{print $3}')
            [ "$status" != "$seen_status" ] && { say "pod $p: $status"; seen_status=$status; }
            local events; events=$(k get events --field-selector "involvedObject.name=$p" --sort-by=.lastTimestamp -o custom-columns=R:.reason,M:.message --no-headers 2>/dev/null)
            if [ "$events" != "$seen_events" ]; then
                comm -13 <(printf '%s\n' "$seen_events" | sort) <(printf '%s\n' "$events" | sort) | sed 's/^/  /'
                seen_events=$events
            fi
            if [ "$status" = "Init:0/1" ] && [ $((SECONDS - last_copy)) -ge 30 ]; then
                local copied; copied=$(k exec "$p" -c seed -- nu -c 'if ("/seed/store" | path exists) { du /seed | get 0.physical | into string } else { "nothing yet" }' 2>/dev/null) || true
                [ -n "$copied" ] && say "  seeding the Nix store from the image: $copied copied so far"
                last_copy=$SECONDS
            fi
        fi
        sleep 5
    done
    die "the pod did not become ready in an hour (kubectl -n $NS describe pod $p)"
}


# The pod's git (the clone into /workspace, and every fetch and push after) uses your key through the forwarded agent, so
# the agent has to hold one, whatever key POLAR_DEV_SSH_KEY logs in with.
agent_has_key() { ssh-add -l >/dev/null 2>&1; }

pubkey() {
    if [ -n "${POLAR_DEV_SSH_KEY:-}" ]; then cat "$POLAR_DEV_SSH_KEY"; return; fi
    # All of the listing first, then its first line: `| head -1` would close the pipe on ssh-add, which pipefail counts as a failure.
    local keys; keys=$(ssh-add -L 2>/dev/null) || true
    [ -n "$keys" ] && [[ "$keys" != "The agent has no identities."* ]] || die "no key in your ssh agent (ssh-add one, or set POLAR_DEV_SSH_KEY to a public key file)"
    printf '%s\n' "${keys%%$'\n'*}"
}

# The kustomization this user's pod is made from: the base in infra/dev-pod, and what is theirs.
render() {
    [ -r "$SOPS_KEY" ] || die "no key for sops at $SOPS_KEY (set POLAR_DEV_SOPS_KEY)"
    # Beside the base, since kustomize takes a base only by a relative path; removed when done.
    local d="$HERE/infra/.dev-pod-$U"; rm -rf "$d"; mkdir -p "$d"; trap 'rm -rf "$d"' RETURN
    local uid gid key class; uid=$(id -u); gid=$(id -g)
    key=$(pubkey) || exit 1
    # A claim's class cannot change once it is bound. Without POLAR_DEV_STORAGE_CLASS, the claims that exist keep theirs:
    # left out of the manifest, it would be cleared, and the apply of every claim fails (made with the variable set, then
    # applied without it).
    class=${POLAR_DEV_STORAGE_CLASS:-$(kubectl -n "$NS" get pvc "polar-dev-nix-$U" -o jsonpath='{.spec.storageClassName}' 2>/dev/null)}
    printf 'apiVersion: v1\nkind: Namespace\nmetadata: { name: %s }\n' "$NS" > "$d/namespace.yaml"
    cat > "$d/kustomization.yaml" <<K
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: $NS
nameSuffix: -$U
resources: [namespace.yaml, ../dev-pod]
images: [{ name: polar-dev, newName: ${IMAGE%:*}, newTag: ${IMAGE##*:} }]
secretGenerator:
  - { name: polar-dev-ssh, literals: ["authorized_keys_b64=$(printf '%s\n' "$key" | base64 | tr -d '\n')"] }
  - { name: polar-dev-sops, files: ["key=$SOPS_KEY"] }
patches:
  - target: { kind: ClusterRoleBinding }
    patch: '[{"op": "replace", "path": "/subjects/0", "value": {"kind": "ServiceAccount", "name": "polar-dev-$U", "namespace": "$NS"}}]'
  - target: { kind: PersistentVolumeClaim }
    patch: '[{"op": "add", "path": "/spec/storageClassName", "value": "$class"}]'
  - patch: |
      apiVersion: apps/v1
      kind: Deployment
      metadata: { name: polar-dev }
      spec:
        template:
          spec:
            nodeSelector: { kubernetes.io/arch: $ARCH }
            securityContext: { fsGroup: $gid }
            initContainers:
              - name: seed
                env: [{ name: CREATE_UID, value: "$uid" }, { name: CREATE_GID, value: "$gid" }]
            containers:
              - name: dev
                env: [{ name: CREATE_USER, value: "$(id -un)" }, { name: CREATE_UID, value: "$uid" }, { name: CREATE_GID, value: "$gid" }]
                volumeMounts:
                  - { name: state, mountPath: $REMOTE_HOME/.local/share/atuin, subPath: atuin }
                  - { name: state, mountPath: $REMOTE_HOME/.config/polar-admin, subPath: polar-admin }
                  - { name: state, mountPath: $REMOTE_HOME/.config/polar-deploy, subPath: polar-deploy }
                  - { name: state, mountPath: $REMOTE_HOME/.cache, subPath: cache }
                  # The pod's SSH host keys live here, so they are the same after a restart and ssh keeps trusting them.
                  - { name: state, mountPath: $REMOTE_HOME/.ssh, subPath: ssh }
K
    [ -n "$class" ] || sed -i.bak '/PersistentVolumeClaim/,+1d' "$d/kustomization.yaml"
    kubectl kustomize --load-restrictor LoadRestrictionsNone "$d"
}

ssh_answers() { ssh_opts; ssh "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$(id -un)@127.0.0.1" true 2>/dev/null; }

# Starts the forward to the pod's SSH and waits until a login works. A forward left from before that does not reach the pod
# (it was made for a pod that has since been replaced) is replaced.
forward_ssh() {
    ssh_answers && return
    pkill -f "port-forward deploy/$DEPLOY $PORT:2223" 2>/dev/null || true
    k port-forward "deploy/$DEPLOY" "$PORT:2223" >/tmp/polar-dev-$U-ssh.log 2>&1 &
    for _ in $(seq 1 60); do ssh_answers && return; sleep 2; done
    die "the pod's SSH does not answer at 127.0.0.1:$PORT (kubectl -n $NS logs deploy/$DEPLOY; /tmp/polar-dev-$U-ssh.log)"
}

login() { forward_ssh; exec ssh "${SSH_OPTS[@]}" -t "$(id -un)@127.0.0.1" "$@"; }

# tar over kubectl exec, so a directory keeps its modes; owned by the user in the pod.
copy_in() { [ -d "$HOME/.config/$1" ] || return 0; tar -C "$HOME/.config" -cf - "$1" | k exec -i "deploy/$DEPLOY" -c dev -- tar -C "$REMOTE_HOME/.config" --no-same-owner -xf -; k exec "deploy/$DEPLOY" -c dev -- chown -R "$(id -u):$(id -g)" "$REMOTE_HOME/.config/$1"; }
# A socket there (gpg-agent's, in a deployment PKI's GnuPG home) cannot be copied; tar leaves it out, and is told not to say so.
copy_out() { mkdir -p "$HOME/.config"; k exec "deploy/$DEPLOY" -c dev -- tar --warning=no-file-ignored -C "$REMOTE_HOME/.config" -cf - "$1" | tar -C "$HOME/.config" -xf -; }

# Every command but the help talks to the cluster: say so plainly when kubectl cannot reach it, before anything is half done.
case "${1:-}" in
    up|attach|cert|forward|sync|down)
        kubectl version --request-timeout=5s >/dev/null 2>&1 || die "the cluster does not answer (KUBECONFIG is ${KUBECONFIG:-not set}): point kubectl at it, then run this again" ;;
esac

case "${1:-}" in
    up)
        agent_has_key || die "your ssh agent holds no key: ssh-add yours (on a Mac, ssh-add --apple-use-keychain ~/.ssh/id_ed25519), then run this again. The pod's git uses it through the forwarded agent, so POLAR_DEV_SSH_KEY alone is not enough"
        ARCH=$(cluster_arch) || exit 1
        IMAGE=${POLAR_DEV_IMAGE:-docker.io/daveman1010220/polar-dev:latest-$ARCH}
        say "applying $NS (image $IMAGE, on $ARCH nodes)"
        manifests=$(render) || exit 1
        printf '%s\n' "$manifests" | kubectl apply -f - | sed 's/^/  /'
        say "waiting for the pod (a first start pulls the image and copies its Nix store to a volume: several minutes)"
        wait_ready
        # The state that lives on this machine goes in, unless the pod has its own already (it keeps what it made).
        for d in polar-deploy polar-admin; do
            if [ -n "$(k exec "deploy/$DEPLOY" -c dev -- ls -A "$REMOTE_HOME/.config/$d" 2>/dev/null)" ]; then
                say "~/.config/$d: the pod has its own, left as it is"
            elif [ -d "$HOME/.config/$d" ]; then
                say "copying ~/.config/$d into the pod"; copy_in "$d"
            fi
        done
        say "forwarding 127.0.0.1:$PORT to the pod's SSH"
        forward_ssh
        if ssh "${SSH_OPTS[@]}" "$(id -un)@127.0.0.1" "test -d /workspace/.git"; then
            say "/workspace already has a checkout"
        else
            say "cloning $REPO ($BRANCH) into /workspace, with your forwarded agent"
            ssh "${SSH_OPTS[@]}" "$(id -un)@127.0.0.1" "GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=accept-new' git clone -b '$BRANCH' '$REPO' /workspace"
        fi
        say "logging in (bin/polar-dev attach to come back)"
        login ;;
    attach) login ;;
    cert)
        u=${2:-$(id -un)}
        copy_out polar-admin
        script=$(mktemp); k exec "deploy/$DEPLOY" -c dev -- cat /workspace/infra/user-cert-install.sh > "$script"
        POLAR_CERT_NEXT="bin/polar-dev forward" bash "$script" "$u"; rm -f "$script" ;;
    forward)
        kubectl -n polar-graph port-forward svc/polar-db-svc 7473:7473 7687:7687 >/tmp/polar-dev-$U-neo4j.log 2>&1 &
        kubectl -n polar port-forward svc/ace-svc 8050:8050 >/tmp/polar-dev-$U-ace.log 2>&1 &
        echo "polar-dev: Neo4j at https://localhost:7473, ACE at http://localhost:8050 (logs in /tmp/polar-dev-$U-*.log)" ;;
    sync) copy_out polar-deploy; copy_out polar-admin; echo "polar-dev: copied polar-deploy and polar-admin to ~/.config" ;;
    down)
        "$0" sync
        if [ "${2:-}" = "--purge" ]; then kubectl delete namespace "$NS"; kubectl delete clusterrolebinding "polar-dev-$U" --ignore-not-found
        else k scale "deploy/$DEPLOY" --replicas=0; fi ;;
    *) sed -n '/^# bin\/polar-dev/,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 1 ;;
esac
