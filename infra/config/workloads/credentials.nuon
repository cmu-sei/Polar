# DM26-0670

# infra/config/workloads/credentials.nuon
#
# The credentials agent: the consumer holds the ledger and issues certificates, the observer is
# its HTTP front. Both say in their own code what they require and how long they need to drain
# (`credentials-agent-consumer --scaffold`); the entries say what else the deployment gives them.
[
  {
    name: "credentials-agent"
    kind: "agent"
    image: "credentials-agent-consumer"
    config: "document"
    # It issues everyone else's certificates, so it cannot be issued through itself.
    bootstrap: true
    # The consumer writes the graph through its own section and must not need Neo4j to be
    # healthy (the ledger is the source of truth, the graph a projection), so its code does not
    # require the graph; the deployment still provides it.
    provides: ["graph-write", "persistent-data"]
    # It issues the certificates the rest of the system starts on, so it starts without waiting
    # for Cassini or Neo4j; the health check still watches both certificates.
    no_start_wait: ["cassini", "neo4j"]
    env: [
      { name: "CREDENTIALS_AGENT_CERT_ISSUER_URL", value: "{cert-issuer.url}" }
      { name: "CREDENTIALS_AGENT_CA_CERT", value: "/etc/polar-ca/ca.pem" }
    ]
  }

  {
    name: "credentials-agent-observer"
    kind: "agent"
    image: "credentials-agent-observer"
    config: "document"
    # It must have a certificate to reach Cassini at all.
    bootstrap: true
    no_start_wait: ["cassini"]
    # External callers (an administrator's tool, a bootstrap step) reach it over HTTP.
    service: { ports: [{ port: 8080 }], port_variable: "CREDENTIALS_AGENT_OBSERVER_PORT" }
  }
]
