# DM26-0670

# infra/config/workloads/cert-issuer.nuon
#
# cert-issuer: the front of Polar's certificate authority. A PolarAgent like the rest (`cert-issuer --scaffold`), of a
# kind of its own, `ca` (config/kinds.nuon): it is the issuer, so its pod has no polar-init, and it signs itself its
# client certificate on its own token, through its own floor (docs/architecture/cert-issuer-isolation.md, step 1c).
# What differs per target (the issuers it trusts, its lifetimes) is in the target's config.
[
  {
    name: "cert-issuer"
    kind: "ca"
    image: "cert-issuer"
    # It cannot be issued through the credentials agent: everything's certificate comes from it.
    bootstrap: true
    config: "document"
    # Its CA, made ahead of time by an operator (`polar-admin-grant bootstrap-ca`) and only loaded.
    provides: ["provisioned-ca"]
    # Callers reach it here; the name and port are services.nuon's.
    service: {
      name: "{cert-issuer.name}"
      ports: [ { name: "https", port: "{cert-issuer.port}" } ]
    }
    env: [
      { name: "CERT_ISSUER_BIND_ADDR",       value: "0.0.0.0:{cert-issuer.port}" }
      # The name its callers connect to, in its own TLS server certificate.
      { name: "CERT_ISSUER_SERVER_IDENTITY", value: "{cert-issuer.dns}" }
      # The one caller that vouches for a request: the credentials agent, by its certificate.
      { name: "CERT_ISSUER_INTERNAL_CALLERS", value: "credentials-agent.polar.serviceaccount.cluster.local" }
      { name: "CERT_ISSUER_DEFAULT_LIFETIME_SECS", value: "3600" }
      { name: "CERT_ISSUER_SERVER_LIFETIME_SECS",  value: "3600" }
      # An account's certificate, the one a person holds: a new one is an administrator's act.
      { name: "CERT_ISSUER_USER_LIFETIME_SECS",    value: "31536000" }
      # Its own token, the kind's projected one, on which it signs itself its client certificate.
      { name: "CERT_ISSUER_OWN_TOKEN",       value: "/workspace/token" }
      # What fetching the Kubernetes API server's keys needs: its CA, beside the automounted token.
      { name: "KUBERNETES_CA_CERT",          value: "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt" }
    ]
  }
]
