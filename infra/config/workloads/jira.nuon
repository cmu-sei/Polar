# DM26-0670

# infra/config/workloads/jira.nuon
#
# Jira agents. The observer polls the Jira REST API and publishes what it finds
# to Cassini; the processor reads those topics and writes to the graph.
#
# The Jira site itself (JIRA_URL, JIRA_DEPLOYMENT, JIRA_ANONYMOUS) is a fact about the
# target, not about the agent, so it lives in targets/<target>/config.nuon. The
# credential is not here: since 3.0.0 it is the observer's signed `credentials`
# runtime section, an escrowed secret only its CryptoActor opens
# (docs/architecture/jira.md, "The credential"); no Secret is given to the pod.
[
  {
    name: "jira-observer"
    kind: "agent"
    # Its node pool, where a target declares placement (docs/architecture/placement.md).
    pool: "observers"
    image: "jira-observer"
    config: "document"
  }

  {
    name: "jira-processor"
    kind: "agent"
    # Its node pool, where a target declares placement (docs/architecture/placement.md).
    pool: "writers"
    image: "jira-processor"
    config: "document"
  }
]
