# infra/config/workloads/git.nuon
#
# The git agents. Each is a PolarAgent: it says in its own code what it needs and how long it takes
# to drain (`git-repo-observer --scaffold`, and so on).
#
# The observer watches the repositories it is told of and publishes their commits and ref updates;
# it never touches the graph. The processor records those events in the graph. The controller holds
# the signed `repositories` section and tells the observer what to observe; it replaced the git
# scheduler (docs/architecture/git-controller.md).
[
  {
    # The Job and ServiceAccount keep the name the chart gave them.
    name: "git-repo-observer"
    kind: "agent"
    image: "git-observer"
    # The crate is not named for the image.
    scaffold_package: "git-repo-observer"
    config: "document"
    # Clones can be fetched again, so the cache does not need to outlive the pod; the image has no
    # directory a non-root user may write, so it is an emptyDir.
    provides: ["working-checkout"]
    env: [
      { name: "POLAR_CACHE_ROOT", value: "/var/lib/{workload}/cache" }
    ]
  }

  {
    name: "git-repo-processor"
    kind: "agent"
    image: "git-processor"
    # The crate is not named for the image.
    scaffold_package: "git-repo-processor"
    config: "document"
  }

  {
    name: "git-repo-controller"
    kind: "agent"
    image: "git-controller"
    # The crate is not named for the image.
    scaffold_package: "git-repo-controller"
    config: "document"
  }
]
