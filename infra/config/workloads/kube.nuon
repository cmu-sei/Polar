# infra/config/workloads/kube.nuon
#
# Kubernetes agents. The observer watches the cluster API and publishes to
# Cassini; the consumer reads Cassini topics and writes to the graph.
[
  {
    name: "kube-observer"
    kind: "agent"
    image: "kube-observer"
    config: "document"
  }

  {
    name: "kube-consumer"
    kind: "agent"
    image: "kube-consumer"
    # The agent says what it needs and how long it needs to drain: `kube-consumer --scaffold`
    # prints it, and the resolver fills the rest from the catalog. Nothing is repeated here.
    config: "document"
  }
]
