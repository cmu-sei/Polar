# infra/config/workloads/secret-harness.nuon
#
# Two pods of one image that check the credentials agent's secret policy from inside the cluster,
# as two different identities (each workload has a service account of its own, which is the
# identity the broker gives it): the owner stores a secret and keeps retrieving it; the intruder
# tries to retrieve it and to take its name, and must be refused. The results are log lines
# beginning `HARNESS RESULT`; `just secret-harness-results` reads them.
#
# The intruder waits before its first round, so that the owner has stored by then and the name is
# not free when it tries to take it.
[
  {
    name: "secret-harness-owner"
    kind: "agent"
    image: "secret-harness"
    config: "document"
    env: [
      { name: "HARNESS_ROLE", value: "owner" }
    ]
  }

  {
    name: "secret-harness-intruder"
    kind: "agent"
    image: "secret-harness"
    config: "document"
    env: [
      { name: "HARNESS_ROLE", value: "intruder" }
      { name: "HARNESS_START_DELAY_SECS", value: "90" }
    ]
  }
]
