# DM26-0670

# infra/config/workloads/secret-harness.nuon
#
# Two pods that check the credentials agent's secret policy from inside the cluster,
# as two different identities (each workload has a service account of its own, which is the
# identity the broker gives it): the owner stores a secret and keeps retrieving it; the intruder
# tries to retrieve it and to take its name, and must be refused. The results are log lines
# beginning `HARNESS RESULT`; `just secret-harness-results` reads them.
#
# Each role is its own build and image (one binary per workload, its name a compile-time constant:
# src/agents/secret-harness/src/supervisor.rs), so neither is told its role at run time.
#
# The secret is named under the owner's identity, `<identity>/harness-secret`: an identity may store only
# under its own name (docs/architecture/credentials-policy.md, "Storing is governed by policy"), so the
# owner can store it and the intruder cannot, and is refused by policy whether or not the name is held.
# The identity is the one the broker gives the owner, `<workload>.polar.serviceaccount.cluster.local`.
#
# The intruder waits before its first round, so that the owner has stored by then.
[
  {
    name: "secret-harness-owner"
    kind: "agent"
    image: "secret-harness-owner"
    # One crate, built twice: the owner is its default build, the intruder its `intruder` feature.
    scaffold_package: "secret-harness"
    config: "document"
    env: [
      { name: "HARNESS_SECRET_NAME", value: "secret-harness-owner.polar.serviceaccount.cluster.local/harness-secret" }
    ]
  }

  {
    name: "secret-harness-intruder"
    kind: "agent"
    image: "secret-harness-intruder"
    scaffold_package: "secret-harness"
    scaffold_features: "intruder"
    config: "document"
    env: [
      { name: "HARNESS_SECRET_NAME", value: "secret-harness-owner.polar.serviceaccount.cluster.local/harness-secret" }
      { name: "HARNESS_START_DELAY_SECS", value: "90" }
    ]
  }
]
