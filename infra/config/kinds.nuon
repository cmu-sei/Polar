# DM26-0670

# infra/config/kinds.nuon
#
# Defaults shared by every workload of a kind. A workload entry overrides any
# of these by naming the field; `needs` is unioned with the kind's.
{
  agent: {
    # Every agent is a Cassini client, and sends its traces to Jaeger. Its polar-init trusts cert-issuer's CA as a
    # mounted file, and verifies what it is issued against it (docs/architecture/core-restarts.md, "The plan", step 1).
    needs: ["cassini", "tracing", "pinned-ca"]
    namespace: "polar"
    # The registry is where an image comes from, and `latest` moves: a node that keeps the first copy it pulled never sees a rebuild
    # (infra/rules.nu checks that no tag that moves is left to IfNotPresent).
    pull_policy: "Always"
    pull_secrets: []

    # Jobs restart through the Job controller, never in place.
    restart_policy: "Never"
    backoff_limit: 1000000
    ttl_after_finished_secs: 300

    probe: { initial_delay_secs: 150, period_secs: 30, failure_threshold: 2, timeout_secs: 5 }

    # Read by HealthCheckActor and the polar-healthcheck probe. These become the agent's
    # configuration (POLAR_HEALTH_*), and `resolve.nu check` runs the agent's own check of
    # its document over every workload (`<agent> --check --config`), so a combination the agent
    # would refuse to start on, such as no room to rejuvenate before the certificate expires,
    # fails the render and names the variables. The rules live in the Rust code, not here.
    health: {
      dir: "/var/run/polar-health"
      volume: "polar-health"
      # The agent is failed outright when its certificate has less than this left.
      expiry_secs: 60
      tick_secs: 30
      # It starts to rejuvenate when its certificate has this much left.
      rejuvenation_secs: 300
      # The liveness probe fails when the health file is older than this.
      stale_secs: 90
    }

    # How long the agent has to drain once told to shut down. The agent builder
    # exits the process 1 when the budget runs out (its watchdog). The pod's
    # terminationGracePeriodSeconds is derived: budget plus the margin, so Kubernetes
    # does not SIGKILL the pod before the watchdog has ended it. It cannot be set
    # separately. A workload overrides the budget; its code declares the least it
    # needs (with_shutdown_budget), and the agent refuses to start if this is less.
    shutdown: { budget_secs: 20, grace_margin_secs: 10 }

    # Where polar-init gets the pod's certificates: `cert-issuer` (what every workload does until it is moved,
    # and what the bootstrap identities always do) or `credentials-agent`. A target moves a workload by
    # setting its `issuer`; the rollout goes in groups. `bootstrap: true` marks the few workloads that
    # cannot go through the credentials agent; only they may name cert-issuer once the floor is enforced
    # (cluster.nuon, `issuance`).
    issuer: "cert-issuer"
    bootstrap: false

    # The projected token polar-init presents to cert-issuer.
    sa_token: { volume: "sa-token", path: "/workspace/token", expiration_secs: 3600 }
  }

  # A service that is not a Cassini client: the broker itself. The same pod, health, shutdown and
  # certificate arrangements as an agent, and none of the client's needs.
  service: {
    extends: "agent"
    needs: ["tracing", "pinned-ca"]
  }

  # The certificate authority's front, cert-issuer, alone (docs/architecture/cert-issuer-isolation.md, step 1c). Its own
  # template, schema/ca.dhall: it is the issuer, so its pod has no polar-init; the kind's projected token is mounted in
  # its own container, on which it signs itself its client certificate through its own floor; the Kubernetes API token
  # is mounted, for fetching the API server's keys; and its files are readable by this group, as a Secret's are.
  ca: {
    extends: "service"
    # Not pinned-ca: it is the CA, and has no polar-init.
    needs: ["tracing"]
    fs_group: 1000
  }
}
