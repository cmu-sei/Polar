# DM26-0670

# infra/config/cluster.nuon
#
# Facts about the cluster Polar runs in. A target may override any of these in
# infra/targets/<target>/config.nuon under the key `cluster`.
{
  # DNS domain of the cluster (kubelet --cluster-domain). Every in-cluster
  # service address is built from this, so changing it here changes them all.
  domain: "cluster.local"

  # Short names used by services.nuon, mapped to real namespaces.
  namespaces: {
    polar: "polar"
    graph: "polar-graph"
    auth: "polar-auth"
  }

  # Registry as the cluster's nodes reach it. For u7s this is the slirp4netns
  # gateway to the host registry started by `just registry-up`.
  registry: "10.0.2.2:5000"

  # The architecture of the cluster's nodes, which decides which digest of the image lock a pinned render uses
  # (an image has one digest per architecture): "amd64" or "arm64".
  arch: "amd64"

  # Audience of the projected ServiceAccount token presented to cert-issuer.
  sa_token_audience: "polar-cert-issuer.local"

  # Who may ask cert-issuer for a certificate with only a token. The bootstrap identities (the workloads
  # that cannot be issued through the credentials agent, because they are what it needs to run) always may.
  # While the floor is off, cert-issuer signs any token holder and `resolve.nu check` lists the workloads
  # that still ask it directly as pending. Turn it on, in the last step of the rollout, only when that list
  # is empty: it then refuses every workload that is not a bootstrap identity, and from then on the same
  # list is an error. The cert-issuer chart's `mtlsEnforceBootstrap` is rendered from this.
  issuance: { floor_enforced: false }

  # Persistent volume claims a workload's capabilities ask for: the storage class the cluster
  # provides and how much each claim asks for.
  storage: { class: "managed-csi", size: "1Gi" }
}
