# DM26-0670

# infra/lock.nu
#
# The image lock: which bytes each image is, in a release. An entry is { image, tag, arch, digest }, one per
# line, sorted, in infra/images.lock.nuon (committed). A manifest that names an image by tag alone does not say
# which bytes run: a rebuilt image under the same tag is a different image behind the same name, and a GitOps
# tool cannot see the change. Pinning writes `registry/name:tag@sha256:...` instead, so the manifest changes
# when the image does. The tag stays for people to read; the digest is what binds.
#
# Two files, one meaning:
#   infra/images.lock.nuon       committed; what a release is made of (written by `nu infra/images.nu lock promote`)
#   infra/images.dev.lock.nuon   ignored; what this machine last pushed (written by every push and mirror)
# A render reads the committed lock with the dev lock laid over it, so rebuilding while developing never
# changes a tracked file. The digest of an image is a property of how it was pushed (the manifest format and the
# layers' compression), not of its content alone, so it is recorded when it is pushed and never recomputed.
#
# This module is pure apart from reading and writing the two files; infra/images.nu records digests, and
# infra/render.nu pins the manifests of a target that sets `pin_images: true`.

const COMMITTED = (path self | path dirname | path join "images.lock.nuon")
const DEV = (path self | path dirname | path join "images.dev.lock.nuon")
const SELF = (path self)

export def committed_path [] { $COMMITTED }
export def dev_path [] { $DEV }

# The license banner this file carries, so the files it generates have it too and cannot lose it.
def banner [] {
    let lines = (open --raw $SELF | lines)
    let start = ($lines | enumerate | where {|r| $r.item | str starts-with "# ACE Tool" } | first | get index)
    let end = ($lines | enumerate | where {|r| $r.item | str contains "DM26-0670" } | first | get index)
    $lines | skip $start | first ($end - $start + 1) | str join "\n"
}

# An image line of a manifest, in the plain and the quoted spelling the catalog writes (`'image': "..."`).
# A reference that already has a digest does not match, so pinning twice changes nothing.
const IMAGE_LINE = r#'^(?<pre>\s*(?:-\s*)?["']?image["']?\s*:\s*["']?)(?<ref>[^"'\s@]+)(?<post>["']?\s*)$'#

export def read_lock [path: string] {
    if ($path | path exists) { open $path } else { [] }
}

# The entry for the same image, tag and architecture is replaced; anything else is added.
export def upsert [rows: list, rec: record] {
    let rest = ($rows | where {|r| not ($r.image == $rec.image and $r.tag == $rec.tag and $r.arch == $rec.arch) })
    $rest | append $rec
}

# `over` laid over `base`: an entry in both is the one in `over`.
export def lay_over [base: list, over: list] {
    $over | reduce --fold $base {|rec, acc| upsert $acc $rec }
}

# What a render uses: the committed lock with this machine's lock over it.
export def effective [] {
    lay_over (read_lock $COMMITTED) (read_lock $DEV)
}

export def lookup [rows: list, image: string, tag: string, arch: string] {
    let hit = ($rows | where {|r| $r.image == $image and $r.tag == $tag and $r.arch == $arch })
    if ($hit | is-empty) { null } else { $hit | first | get digest }
}

# The text of a lock file: the banner, what it is, and one sorted entry per line, so a diff shows what changed.
export def format_lock [rows: list, what: string] {
    let body = ($rows
        | sort-by image tag arch
        | each {|r| $"  {image: \"($r.image)\", tag: \"($r.tag)\", arch: \"($r.arch)\", digest: \"($r.digest)\"}" }
        | str join "\n")
    $"(banner)\n\n# Generated by `nu infra/images.nu`: do not edit. ($what)\n[\n($body)\n]\n"
}

export def write_lock [path: string, rows: list, what: string] {
    format_lock $rows $what | save --force $path
}

# Records the digest an image has in the registry, in this machine's lock.
export def record [image: string, tag: string, arch: string, digest: string] {
    let rows = (upsert (read_lock $DEV) { image: $image, tag: $tag, arch: $arch, digest: $digest })
    write_lock $DEV $rows "The digests this machine last pushed; they lie over images.lock.nuon in a render."
}

# Makes this machine's lock the committed one, for a release: the entries of the two, the dev ones winning.
export def promote [] {
    let rows = (effective)
    write_lock $COMMITTED $rows "What a release is made of: the digest each image has in the registry."
    $rows
}

# What is wrong with a lock itself.
export def lock_problems [rows: list] {
    mut problems = []
    for r in $rows {
        if not ($r.digest =~ '^sha256:[0-9a-f]{64}$') {
            $problems = ($problems | append $"($r.image):($r.tag) \(($r.arch)\) has a digest that is not sha256:<64 hex>: ($r.digest)")
        }
    }
    for k in ($rows | each {|r| $"($r.image):($r.tag) ($r.arch)" } | uniq --repeated) {
        $problems = ($problems | append $"($k) is in the lock more than once")
    }
    $problems
}

# "registry/name:tag" -> { name, tag }, or null when the reference is not in `registry`.
def split_ours [ref: string, registry: string] {
    let prefix = $"($registry)/"
    if not ($ref | str starts-with $prefix) { return null }
    let rest = ($ref | str substring ($prefix | str length)..)
    let m = ($rest | parse --regex '^(?<name>.+?)(?::(?<tag>[^:/]+))?$' | first)
    { name: $m.name, tag: (if ($m.tag | is-empty) { "latest" } else { $m.tag }) }
}

def pin_line [line: string, rows: list, registry: string, arch: string] {
    let m = ($line | parse --regex $IMAGE_LINE)
    if ($m | is-empty) { return { out: $line, missing: null, pinned: false } }
    let g = ($m | first)
    let parts = (split_ours $g.ref $registry)
    if $parts == null { return { out: $line, missing: null, pinned: false } }
    let digest = (lookup $rows $parts.name $parts.tag $arch)
    if $digest == null {
        { out: $line, missing: $"($parts.name):($parts.tag)", pinned: false }
    } else {
        { out: $"($g.pre)($g.ref)@($digest)($g.post)", missing: null, pinned: true }
    }
}

# The manifest text with every image of `registry` named by digest. `missing` lists what the lock has no entry
# for (for `arch`); those lines are left as they were, and the caller decides what that means.
export def pin_text [text: string, rows: list, registry: string, arch: string] {
    let results = ($text | lines | each {|l| pin_line $l $rows $registry $arch })
    let joined = ($results | get out | str join "\n")
    {
        text: (if ($text | str ends-with "\n") { $"($joined)\n" } else { $joined })
        missing: ($results | get missing | compact | uniq | sort)
        pinned: ($results | where pinned | length)
    }
}
