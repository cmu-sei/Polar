# DM26-0670
# infra/load-plans/enforcement.nuon
#
# Stage 5b measured against the baseline (docs/architecture/policy-enforcement.md, docs/architecture/broker-baseline.md):
# the baseline's grid, with the broker deciding every publish and subscribe, twice: deciding each one
# (CASSINI_DECISION_CACHE_SECS 0), and keeping each connection's decisions for the default five seconds. 32 runs. The
# harness restarts the broker with each setting, so Flux's polar-agents must be suspended, as the procedure has it.
#
#   nu infra/load-harness.nu run infra/load-plans/enforcement.nuon --target sandbox-local
{
  name: "enforcement"
  defaults: { seconds: 20, max_count: 100000, max_bytes: 1073741824, warmup: 100 }
  grid: {
    size: [256 4096 65536 1048576]
    rate: [100 1000 10000 0]
    shape: [
      { producers: 1, sinks: 1, lanes: 1 }
    ]
  }
  broker: { CASSINI_DECISION_CACHE_SECS: [0 5] }
}
