# DM26-0670
# infra/load-plans/saturated.nuon
#
# The baseline's saturated large-message rows alone (broker-baseline.md, the fourth set's peak, and the fifth set):
# 64 KiB and 1 MiB as fast as the window allows, one producer and one sink, the baseline's defaults. 2 runs. The fourth
# and fifth sets sample the broker's cgroup every 100 ms beside them, outside the harness.
#
#   nu infra/load-harness.nu run infra/load-plans/saturated.nuon --target sandbox-local
{
  name: "saturated"
  defaults: { seconds: 20, max_count: 100000, max_bytes: 1073741824, warmup: 100, rate: 0 }
  grid: {
    size: [65536 1048576]
    shape: [
      { producers: 1, sinks: 1, lanes: 1 }
    ]
  }
}
