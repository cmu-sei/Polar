# infra/targets/local-minimal/config.nuon
#
# Overrides applied on top of infra/config for this target:
#   cluster    any field of cluster.nuon
#   workloads  per-workload fields, keyed by workload name
{
  cluster: {}
  workloads: {
    # Who administers the git server in development: the DNS names in the certificates of the
    # accounts `just admin-claim` made on this cluster (djshepard, operator, seeder). They belong to this
    # cluster's ledger and change when it is reset: read them with
    #   openssl x509 -in ~/.config/polar-admin/<user>.crt -noout -ext subjectAltName
    polar-git-server: {
      env: [
        { name: "POLAR_GIT_SERVER_ADMINS", value: "381258d0-9180-40c8-a0b0-074739719963" }
      ]
    }
    # The cluster pulls from the development registry over plain http, and so must the resolver.
    oci-registry-resolver: {
      env: [
        { name: "OCI_INSECURE_REGISTRIES", value: "10.0.2.2:5000" }
      ]
    }
    # Rollout of cert-issuer isolation (docs/architecture/cert-issuer-isolation.md, phase 6), in groups. A
    # workload on the credentials agent gets its certificates through the observer, so the credentials agent
    # has a record of it. Group 1 is the secret harness, which is the check on the rest.
    secret-harness-owner: { issuer: "credentials-agent" }
    secret-harness-intruder: { issuer: "credentials-agent" }
    jira-observer: {
      env: [
        { name: "JIRA_URL", value: "https://daveman1010220.atlassian.net" }
        { name: "JIRA_EMAIL", value: "daveman1010220@gmail.com" }
      ]
    }
  }
}
