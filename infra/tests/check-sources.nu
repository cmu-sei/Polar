# infra/tests/check-sources.nu
#
# The check that every source the build fetches can be fetched anonymously at its pinned revision: how the git
# sources are read out of a Cargo.lock and the remote inputs out of a flake.lock, that a source used twice is
# checked once, how an HTTP status chain and git's answer are read, and what is printed and returned (one line per
# failure, a summary, a distinct exit when github.com cannot be reached at all). No network: the checks are
# closures. The fixtures are cut from the real lock files; the dhall-rust line is the one that vanished from GitHub.
#
#   nu infra/tests/check-sources.nu

use std/assert
use ../check-sources.nu *

const DHALL_URL = "https://github.com/daveman1010221/dhall-rust"
const DHALL_REV = "776439e8acd9381f176fd70dc68976aaf367d551"
const DHALL = "git+https://github.com/daveman1010221/dhall-rust?branch=modernize-rkyv#776439e8acd9381f176fd70dc68976aaf367d551"

const CARGO_LOCK = '# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 4

[[package]]
name = "abnf_to_pest"
version = "0.5.1"
source = "git+https://github.com/daveman1010221/dhall-rust?branch=modernize-rkyv#776439e8acd9381f176fd70dc68976aaf367d551"

[[package]]
name = "serde_dhall"
version = "0.13.0"
source = "git+https://github.com/daveman1010221/dhall-rust?branch=modernize-rkyv#776439e8acd9381f176fd70dc68976aaf367d551"

[[package]]
name = "neo4rs"
version = "0.9.0"
source = "git+https://github.com/daveman1010221/neo4rs?rev=4117f5a#4117f5aac44a5e70b1a232fd1ae0d842454e12a8"

[[package]]
name = "getrandom"
version = "0.3.3"
source = "git+https://github.com/rust-random/getrandom?tag=v0.3.3#82396406b28f23ba86e3e511d34a4f5dab0fda08"

[[package]]
name = "serde"
version = "1.0.219"
source = "registry+https://github.com/rust-lang/crates.io-index"
checksum = "5f0e2c6ed6606019b4e29e69dbaba95b11854410e5347d525002456dbbb786b6"

[[package]]
name = "cassini-types"
version = "0.1.0"
'

const FLAKE_LOCK = '{
  "nodes": {
    "nixpkgs": {
      "locked": { "lastModified": 1718714799, "narHash": "sha256-x=", "owner": "nixos", "repo": "nixpkgs",
                  "rev": "c00d587b1a1afbf200b1d8f0b0e4ba9deb1c7f0e", "type": "github" },
      "original": { "owner": "nixos", "ref": "nixos-unstable", "repo": "nixpkgs", "type": "github" }
    },
    "enterprise": {
      "locked": { "host": "git.example.org", "owner": "o", "repo": "r", "rev": "1111111111111111111111111111111111111111", "type": "github" },
      "original": { "host": "git.example.org", "owner": "o", "repo": "r", "type": "github" }
    },
    "plain-git": {
      "locked": { "type": "git", "url": "https://git.example.org/a/b.git", "ref": "main", "rev": "2222222222222222222222222222222222222222" },
      "original": { "type": "git", "url": "https://git.example.org/a/b.git" }
    },
    "lab": {
      "locked": { "type": "gitlab", "owner": "group%2Fsub", "repo": "proj", "rev": "3333333333333333333333333333333333333333" },
      "original": { "type": "gitlab", "owner": "group%2Fsub", "repo": "proj" }
    },
    "ball": {
      "locked": { "type": "tarball", "url": "https://example.org/x-1.0.tar.gz", "narHash": "sha256-y=" },
      "original": { "type": "tarball", "url": "https://example.org/x-latest.tar.gz" }
    },
    "remote-file": {
      "locked": { "type": "file", "url": "https://example.org/data.json", "narHash": "sha256-z=" },
      "original": { "type": "file", "url": "https://example.org/data.json" }
    },
    "local-file": {
      "locked": { "type": "file", "url": "file:///home/someone/data.json", "narHash": "sha256-z=" },
      "original": { "type": "file", "url": "file:///home/someone/data.json" }
    },
    "local-path": {
      "locked": { "type": "path", "path": "./src/local", "narHash": "sha256-w=" },
      "original": { "type": "path", "path": "./src/local" }
    },
    "local-git": {
      "locked": { "type": "git", "url": "file:///home/someone/repo", "rev": "4444444444444444444444444444444444444444" },
      "original": { "type": "git", "url": "file:///home/someone/repo" }
    },
    "root": { "inputs": { "nixpkgs": "nixpkgs" } }
  },
  "root": "root",
  "version": 7
}'

def has [lines: list, needle: string] { $lines | any {|l| $l | str contains $needle } }

def node [sources: list, name: string] { $sources | where what == $"flake input ($name)" | get -o 0 }

# Checks as the main loop builds them, for the report tests.
def a_check [url: string, rev: string] { { check: "git", url: $url, rev: $rev, used_by: ["src/agents/Cargo.lock: x"] } }

def main [] {
    let tests = [
        {
            name: "the real dhall-rust source: the URL without its query, the revision after #"
            body: { assert equal (cargo_source $DHALL) { url: $DHALL_URL, rev: $DHALL_REV } }
        }
        {
            name: "a ?rev= source pins the full revision after #, not the short one in the query"
            body: {
                assert equal (cargo_source "git+https://github.com/daveman1010221/neo4rs?rev=4117f5a#4117f5aac44a5e70b1a232fd1ae0d842454e12a8") {
                    url: "https://github.com/daveman1010221/neo4rs", rev: "4117f5aac44a5e70b1a232fd1ae0d842454e12a8"
                }
            }
        }
        {
            name: "a ?tag= source, and a .git URL kept as written"
            body: {
                assert equal (cargo_source "git+https://github.com/rust-random/getrandom?tag=v0.3.3#82396406b28f23ba86e3e511d34a4f5dab0fda08") {
                    url: "https://github.com/rust-random/getrandom", rev: "82396406b28f23ba86e3e511d34a4f5dab0fda08"
                }
                assert equal (cargo_source "git+https://github.com/daveman1010221/RSA.git?rev=aa4bc50#aa4bc50c0e212987610c7c7afc390942ff57820a").url "https://github.com/daveman1010221/RSA.git"
            }
        }
        {
            name: "a source with no query at all"
            body: { assert equal (cargo_source "git+https://example.org/r#abc123") { url: "https://example.org/r", rev: "abc123" } }
        }
        {
            name: "a git source with no pinned revision is kept, with an empty revision, so it fails rather than passes"
            body: { assert equal (cargo_source "git+https://example.org/r?branch=main") { url: "https://example.org/r", rev: "" } }
        }
        {
            name: "registry sources are not git sources"
            body: {
                assert equal (cargo_source "registry+https://github.com/rust-lang/crates.io-index") null
                assert equal (cargo_source "sparse+https://index.crates.io/") null
            }
        }
        {
            name: "a Cargo.lock gives one entry per git package, none for registry or path packages"
            body: {
                let s = (cargo_sources $CARGO_LOCK "src/agents/Cargo.lock")
                assert equal ($s | length) 4
                assert equal ($s | get check | uniq) ["git"]
                assert equal ($s | where what == "crate serde_dhall" | get 0) {
                    check: "git", url: $DHALL_URL, rev: $DHALL_REV, what: "crate serde_dhall", from: "src/agents/Cargo.lock"
                }
            }
        }
        {
            name: "a Cargo.lock with no git packages gives none"
            body: { assert equal (cargo_sources "version = 4\n\n[[package]]\nname = \"a\"\nversion = \"1.0.0\"\n" "x/Cargo.lock") [] }
        }
        {
            name: "a github input is checked by its archive at the locked revision, on github.com unless another host is locked"
            body: {
                let s = (flake_sources $FLAKE_LOCK "flake.lock")
                assert equal (node $s "nixpkgs") {
                    check: "http"
                    url: "https://github.com/nixos/nixpkgs/archive/c00d587b1a1afbf200b1d8f0b0e4ba9deb1c7f0e.tar.gz"
                    rev: "c00d587b1a1afbf200b1d8f0b0e4ba9deb1c7f0e"
                    what: "flake input nixpkgs"
                    from: "flake.lock"
                }
                assert equal (node $s "enterprise").url "https://git.example.org/o/r/archive/1111111111111111111111111111111111111111.tar.gz"
            }
        }
        {
            name: "a git input is fetched from its URL at its revision"
            body: {
                let n = (node (flake_sources $FLAKE_LOCK "flake.lock") "plain-git")
                assert equal [$n.check $n.url $n.rev] ["git" "https://git.example.org/a/b.git" "2222222222222222222222222222222222222222"]
            }
        }
        {
            name: "a gitlab input is fetched over git from gitlab.com, its owner's subgroups decoded"
            body: {
                let n = (node (flake_sources $FLAKE_LOCK "flake.lock") "lab")
                assert equal [$n.check $n.url $n.rev] ["git" "https://gitlab.com/group/sub/proj.git" "3333333333333333333333333333333333333333"]
            }
        }
        {
            name: "a tarball, and a file from the network, are checked by their locked URL"
            body: {
                let s = (flake_sources $FLAKE_LOCK "flake.lock")
                assert equal [(node $s "ball").check (node $s "ball").url] ["http" "https://example.org/x-1.0.tar.gz"]
                assert equal [(node $s "remote-file").check (node $s "remote-file").url] ["http" "https://example.org/data.json"]
            }
        }
        {
            name: "path inputs, local files and local git repositories are not fetched, so not checked; nor is the root"
            body: {
                let s = (flake_sources $FLAKE_LOCK "flake.lock")
                for n in ["local-path" "local-file" "local-git" "root"] { assert equal (node $s $n) null $n }
                assert equal ($s | length) 6
            }
        }
        {
            name: "an input of a type this check does not know is reported, not skipped"
            body: {
                let lock = '{"nodes": {"hut": {"locked": {"type": "sourcehut", "owner": "~o", "repo": "r", "rev": "5555"}}}, "root": "root", "version": 7}'
                assert equal (node (flake_sources $lock "flake.lock") "hut").check "unsupported"
            }
        }
        {
            name: "an ssh git input needs credentials, so it is reported, not fetched"
            body: {
                let lock = '{"nodes": {"s": {"locked": {"type": "git", "url": "ssh://git@github.com/o/r", "rev": "6666"}}}, "root": "root", "version": 7}'
                assert equal (node (flake_sources $lock "flake.lock") "s").check "unsupported"
            }
        }
        {
            name: "a source used by several packages and lock files is checked once, and says who uses it"
            body: {
                let s = (cargo_sources $CARGO_LOCK "src/agents/Cargo.lock") | append (cargo_sources $CARGO_LOCK "src/git-hooks/Cargo.lock")
                let u = (unique_checks $s)
                assert equal ($u | length) 3
                let d = ($u | where url == $DHALL_URL | get 0)
                assert equal $d.rev $DHALL_REV
                assert equal ($d.used_by | length) 4
                assert (has $d.used_by "src/git-hooks/Cargo.lock: crate serde_dhall")
            }
        }
        {
            name: "the same URL at two revisions is two checks"
            body: {
                let s = [
                    { check: "git", url: "https://e.org/r", rev: "a", what: "crate x", from: "A" }
                    { check: "git", url: "https://e.org/r", rev: "b", what: "crate x", from: "B" }
                ]
                assert equal (unique_checks $s | length) 2
            }
        }
        {
            name: "the checks do not depend on the order the lock files were read in"
            body: {
                let a = (cargo_sources $CARGO_LOCK "A")
                let b = (flake_sources $FLAKE_LOCK "B")
                assert equal (unique_checks ($a | append $b)) (unique_checks ($b | append $a))
            }
        }
        {
            name: "status codes: 200 and 302 ok, 301 moved, 404 missing, anything else an error"
            body: {
                assert equal (classify_http 200) "ok"
                assert equal (classify_http 302) "ok"
                assert equal (classify_http 301) "moved"
                assert equal (classify_http 404) "missing"
                for c in [0 401 403 429 500 503] { assert equal (classify_http $c) "error" $"($c)" }
            }
        }
        {
            name: "a redirect chain is judged by where it ends: GitHub answers 302 even for a revision it does not have"
            body: {
                assert equal (http_verdict [302 200]) "ok"
                assert equal (http_verdict [302 404]) "missing"
                assert equal (http_verdict [404]) "missing"
                assert equal (http_verdict [200]) "ok"
            }
        }
        {
            name: "a chain through a 301 that ends well is a moved repository, which Nix follows"
            body: {
                assert equal (http_verdict [301 302 200]) "moved"
                assert equal (http_verdict [301 302 404]) "missing"
            }
        }
        {
            name: "no answer at all is an error"
            body: { assert equal (http_verdict []) "error" }
        }
        {
            name: "git: success is ok; a request for credentials means the repository is gone or private"
            body: {
                assert equal (git_verdict 0 "") "ok"
                assert equal (git_verdict 128 "fatal: could not read Username for 'https://github.com': terminal prompts disabled") "missing"
            }
        }
        {
            name: "git: a revision the server does not have is missing"
            body: { assert equal (git_verdict 128 "fatal: remote error: upload-pack: not our ref 0000000000000000000000000000000000000001") "missing" }
        }
        {
            name: "git: a fetch killed by timeout is a timeout; anything else is an error"
            body: {
                assert equal (git_verdict 124 "") "timeout"
                assert equal (git_verdict 128 "fatal: unable to access 'https://e.org/': Could not resolve host: e.org") "error"
            }
        }
        {
            name: "all ok: exit 0 and a summary that counts them"
            body: {
                let r = (check_all [(a_check "https://e.org/a" "1") (a_check "https://e.org/b" "2")] { true } {|c| { verdict: "ok", detail: "" } })
                assert equal $r.exit_code 0
                assert (has $r.lines "2 sources checked")
                assert (not (has $r.lines "FAIL"))
            }
        }
        {
            name: "one line per failure naming the URL, the revision and who uses it, and exit 1"
            body: {
                let checks = [(a_check $DHALL_URL $DHALL_REV) (a_check "https://e.org/b" "2") (a_check "https://e.org/c" "3")]
                let r = (check_all $checks { true } {|c| if $c.url == "https://e.org/b" { { verdict: "ok", detail: "" } } else { { verdict: "missing", detail: "gone" } } })
                assert equal $r.exit_code 1
                let fails = ($r.lines | where {|l| $l | str contains "FAIL" })
                assert equal ($fails | length) 2
                assert (has $fails $"($DHALL_URL) @ ($DHALL_REV)")
                assert (has $fails "src/agents/Cargo.lock: x")
                assert (has $fails "gone")
                assert (has $r.lines "2 failed")
            }
        }
        {
            name: "a moved repository is said, and does not fail the check"
            body: {
                let r = (check_all [(a_check "https://e.org/a" "1")] { true } {|c| { verdict: "moved", detail: "" } })
                assert equal $r.exit_code 0
                assert (has $r.lines "moved")
                assert (has $r.lines "https://e.org/a")
            }
        }
        {
            name: "unsupported and unpinned sources fail without being fetched"
            body: {
                let checks = [
                    { check: "unsupported", url: "ssh://git@e.org/r", rev: "1", used_by: ["flake.lock: flake input s"], detail: "needs credentials" }
                    (a_check "https://e.org/r" "")
                ]
                let r = (check_all $checks { true } {|c| error make { msg: "fetched" } })
                assert equal $r.exit_code 1
                assert equal ($r.lines | where {|l| $l | str contains "FAIL" } | length) 2
            }
        }
        {
            name: "github.com unreachable: says so, checks nothing and exits with its own code"
            body: {
                let r = (check_all [(a_check "https://e.org/a" "1")] { false } {|c| error make { msg: "fetched" } })
                assert equal $r.exit_code $EXIT_OFFLINE
                assert ($EXIT_OFFLINE not-in [0 1])
                assert (has $r.lines "github.com")
                assert (not (has $r.lines "FAIL"))
            }
        }
        {
            name: "the git fetch never reaches for the user's credentials"
            body: {
                let e = (git_env)
                assert equal $e.GIT_TERMINAL_PROMPT "0"
                assert equal $e.GIT_ASKPASS ""
                assert equal $e.SSH_ASKPASS ""
                assert equal $e.GIT_CONFIG_GLOBAL "/dev/null"
                assert equal $e.GIT_CONFIG_NOSYSTEM "1"
                let a = (git_fetch_args "/tmp/x" "https://e.org/r" "abc")
                assert ("credential.helper=" in $a)
                assert ("core.askPass=" in $a)
                assert equal ($a | last 2) ["https://e.org/r" "abc"]
                assert equal ($a | describe) "list<string>"
            }
        }
        {
            name: "curl ignores .curlrc and netrc"
            body: {
                let a = (curl_args "https://e.org/x")
                assert equal ($a | first) "-q"
                assert (not ($a | any {|x| $x =~ 'netrc' or $x == "-n" }))
                assert equal ($a | last) "https://e.org/x"
            }
        }
        {
            name: "the pipeline summaries keep every line the report makes, failures, moves, summary and offline alike"
            body: {
                let fail = (check_all [(a_check "https://e.org/a" "1") (a_check "https://e.org/b" "2")] { true } {|c|
                    if $c.url == "https://e.org/a" { { verdict: "missing", detail: "gone" } } else { { verdict: "moved", detail: "" } }
                })
                assert equal (summary_lines $fail.lines) $fail.lines
                let offline = (check_all [(a_check "https://e.org/a" "1")] { false } {|c| error make { msg: "fetched" } })
                assert equal (summary_lines $offline.lines) $offline.lines
            }
        }
        {
            name: "the pipeline summaries drop the header and anything else in the output file"
            body: {
                let out = ["checking 35 sources from flake.lock, src/agents/Cargo.lock" "Error: nu::shell::something" "35 sources checked: 35 ok, 0 moved, 0 failed"]
                assert equal (summary_lines $out) ["35 sources checked: 35 ok, 0 moved, 0 failed"]
            }
        }
    ]

    let results = ($tests | each {|t|
        try { do $t.body; { name: $t.name, error: null } } catch {|e| { name: $t.name, error: $e.msg } }
    })
    for r in $results {
        if $r.error == null { print $"  ok    ($r.name)" } else { print -e $"  FAIL  ($r.name): ($r.error)" }
    }
    let failed = ($results | where error != null | length)
    if $failed > 0 { print -e $"($failed) of ($results | length) failed"; exit 1 }
    print $"all ($results | length) passed"
}
