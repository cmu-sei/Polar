# -----------------------------------------------------------------
# Neo4j Schema Configuration
#
# These environment variables let Db.py target a differently-shaped
# Neo4j graph without code changes. Values below are the defaults
# Db.py falls back to if the corresponding env var is unset -- they
# match the current, live graph schema (JiraIssue_* node labels).
#
# In deployment these are delivered the same way as NEO4J_URI/etc --
# via the orchestrator's Secret/ConfigMap mechanism, not a file read
# by the application.
# -----------------------------------------------------------------

# ── Node labels ──────────────────────────────────────────────────
SCHEMA_TEAM_LABEL=JiraIssue_Agile_Team
SCHEMA_ISSUE_LABEL=JiraIssue
SCHEMA_PI_LABEL=JiraIssue_Program_Increment
SCHEMA_CHANGELOG_LABEL=JiraIssueChangeLog
SCHEMA_ISSUE_TYPE_LABEL=JiraIssueType
SCHEMA_STATUS_LABEL=JiraIssue_Status

# ── Relationship types ───────────────────────────────────────────
SCHEMA_HAS_AGILE_TEAM_REL=HAS_AGILE_TEAM
SCHEMA_HAS_PROGRAM_INCREMENT_REL=HAS_PROGRAM_INCREMENT
SCHEMA_TRANSITIONED_REL=Transitioned
SCHEMA_HAS_TYPE_REL=HAS_TYPE
SCHEMA_HAS_STATUS_REL=HAS_STATUS
SCHEMA_HAS_SPRINT_REL=HAS_SPRINT

# ── Property names ───────────────────────────────────────────────
SCHEMA_TEAM_VALUE_PROP=value
SCHEMA_PI_VALUE_PROP=value
SCHEMA_ISSUE_KEY_PROP=key
SCHEMA_STORY_POINTS_PROP=Story Points
SCHEMA_ISSUE_TYPE_NAME_PROP=name
SCHEMA_STORY_TYPE_NAME=Story
